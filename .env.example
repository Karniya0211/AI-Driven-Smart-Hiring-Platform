# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/resume_matcher
JWT_SECRET=replace-with-a-long-random-secret

# Frontend API base URL. For Vite dev mode, the proxy forwards /api requests to the backend.
# For a standalone frontend, set this explicitly to the backend origin, e.g. http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Optional future provider integration; leave unset for the working rule-based fallback
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
